{
  "name": "@aspect-evp/verifier",
  "version": "0.2.0",
  "description": "EVP token verification for web applications (Relying Parties)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "evp",
    "email-verification",
    "verifier",
    "sd-jwt",
    "rp"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aspect-evp/evp-js.git",
    "directory": "packages/verifier"
  },
  "dependencies": {
    "@aspect-evp/core": "workspace:*",
    "jose": "^6.2.1"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "@aspect-evp/core": "^0.1.1 || ^0.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
