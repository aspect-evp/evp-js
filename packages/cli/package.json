{
  "name": "@aspect-evp/cli",
  "version": "0.2.0",
  "description": "CLI tool for Email Verification Protocol testing and development",
  "type": "module",
  "bin": {
    "evp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli.ts"
  },
  "keywords": [
    "evp",
    "email-verification",
    "cli",
    "sd-jwt",
    "testing"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aspect-evp/evp-js.git",
    "directory": "packages/cli"
  },
  "dependencies": {
    "@aspect-evp/core": "workspace:*",
    "@aspect-evp/issuer": "workspace:*",
    "@aspect-evp/verifier": "workspace:*",
    "citty": "^0.2.1",
    "consola": "^3.2.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
