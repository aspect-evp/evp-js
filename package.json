{
  "name": "evp-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Email Verification Protocol (EVP) reference implementation",
  "repository": {
    "type": "git",
    "url": "https://github.com/aspect-evp/evp-js.git"
  },
  "keywords": [
    "evp",
    "email-verification",
    "sd-jwt",
    "wicg",
    "authentication"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs:check": "node scripts/check-docs.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "typecheck": "pnpm -r typecheck",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && pnpm test && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@changesets/cli": "^2.29.8",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.15",
    "typescript": "^5.3.0",
    "vitest": "^4.0.15"
  }
}
