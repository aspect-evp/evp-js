{
  "name": "evp-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Email Verification Protocol (EVP) reference implementation",
  "repository": {
    "type": "git",
    "url": "https://github.com/aspect-evp/evp-js.git"
  },
  "keywords": [
    "evp",
    "email-verification",
    "sd-jwt",
    "wicg",
    "authentication"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs:check": "node scripts/check-docs.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "typecheck": "pnpm -r typecheck",
    "security:audit": "pnpm --package=@pnpm/exe@11.13.1 dlx pnpm --pm-on-fail=ignore audit --audit-level=high",
    "security:audit:prod": "pnpm --package=@pnpm/exe@11.13.1 dlx pnpm --pm-on-fail=ignore audit --prod --audit-level=moderate",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && pnpm test && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@changesets/cli": "^3.0.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "js-yaml@<3.15.0": "3.15.0",
      "js-yaml@>=4.0.0 <4.3.0": "4.3.0",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.5": "4.0.5",
      "postcss@<8.5.10": "8.5.19",
      "vite@>=7.0.0 <7.3.6": "7.3.6"
    }
  }
}
